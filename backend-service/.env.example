# PostgreSQL connection string (Prisma)
DATABASE_URL="postgresql://saba:saba_dev_pw@127.0.0.1:5432/saba_nursery?schema=public"

# HTTP server
PORT=4000
NODE_ENV=development

# Auth. Production refuses this placeholder and any secret shorter than 24 characters.
# There is no refresh token. A 401 clears the client session.
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="12h"
BCRYPT_SALT_ROUNDS=12

# Security / CORS
CORS_ORIGIN="http://localhost:5173"
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
# Swagger at /api/docs — defaults on in development, off in production unless true
ENABLE_API_DOCS=true

# Seed admin (used by prisma/seed.ts)
SEED_ADMIN_EMAIL="admin@sabanursery.com"
SEED_ADMIN_PASSWORD="Admin@12345"
