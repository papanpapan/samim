# Staging API (Render). Copy to .env.staging for a local staging run; on Render set these in the dashboard.
# Use a SEPARATE database. Never point staging at the production nursery database.
DATABASE_URL="postgresql://saba_staging:CHANGE_ME@HOST:5432/saba_staging?schema=public"

PORT=4000
# production keeps the JWT secret guard on; the Testing Mode badge comes from the client VITE_APP_ENV
NODE_ENV=production

# At least 24 random characters. Render can generate it (render.yaml: generateValue).
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
JWT_EXPIRES_IN="12h"
BCRYPT_SALT_ROUNDS=12

# The staging web URL (comma-separated for more than one)
CORS_ORIGIN="https://saba-agrico-staging.vercel.app"
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Vercel rewrite + Render proxy
TRUST_PROXY=2
ENABLE_API_DOCS=true

# Demo logins for testers (prisma/seed.ts)
SEED_ADMIN_EMAIL="admin@sabanursery.com"
SEED_ADMIN_PASSWORD="CHANGE_ME"
