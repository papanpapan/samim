// Saba Nursery Enterprise Resource & Smart Inventory Management System (SN-ERMS)
// PostgreSQL enterprise data model (see technical specification section 7).

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MANAGER
  STAFF
  CASHIER
}

enum PropagationMethod {
  AIR_LAYERING
  SOFTWOOD_GRAFTING
  CLEFT_GRAFTING
  PATCH_BUDDING
  CUTTING
  SEEDLING
}

enum BatchStage {
  INITIATED
  MIST_CHAMBER
  HARDENING_SHADE
  READY_FOR_SALE
  CLOSED
}

enum SalesChannel {
  RETAIL_COUNTER
  WHOLESALE_ORCHARDIST
  INDIAMART
  MEESHO
  AMAZON
}

enum PaymentMode {
  CASH
  UPI_PHONEPE_GPAY
  BANK_NEFT_IMPS
  CREDIT_NOTE
  SPLIT
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  phone        String?
  passwordHash String
  role         Role       @default(STAFF)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
}

model MotherPlant {
  id             String             @id @default(uuid())
  tagNumber      String             @unique // e.g. MP-BDG-001
  varietyName    String // Black Diamond Guava, Thai King Jamun
  scientificName String?
  sourceCountry  String? // Thailand, Vietnam, Malaysia
  plantingDate   DateTime
  plotLocation   String // Plot A, Row 3, Tree 15
  healthStatus   String             @default("EXCELLENT")
  scionsHarvested Int               @default(0)
  notes          String?
  propagations   PropagationBatch[]
  createdAt      DateTime           @default(now())
}

model PropagationBatch {
  id              String            @id @default(uuid())
  batchCode       String            @unique // BATCH-2026-BDG-01
  motherPlantId   String
  motherPlant     MotherPlant       @relation(fields: [motherPlantId], references: [id])
  method          PropagationMethod
  initialQuantity Int
  currentQuantity Int
  mortalityCount  Int               @default(0)
  stage           BatchStage        @default(INITIATED)
  startDate       DateTime          @default(now())
  mistChamberDate DateTime?
  hardeningDate   DateTime?
  readyDate       DateTime?
  plants          PlantInventory[]
}

model PlantInventory {
  id             String            @id @default(uuid())
  sku            String            @unique // PLT-BDG-5X7-01
  commonName     String // Black Diamond Guava
  variety        String // Thai Hybrid
  category       String // Fruit, Ornamental, Indoor
  bagSize        String // 5x7 inch, 8x10 inch, 12 inch Tob
  currentStock   Int               @default(0)
  reorderAlert   Int               @default(15)
  costPrice      Decimal           @db.Decimal(10, 2)
  retailPrice    Decimal           @db.Decimal(10, 2)
  wholesalePrice Decimal           @db.Decimal(10, 2)
  qrCodeData     String?
  batchId        String?
  batch          PropagationBatch? @relation(fields: [batchId], references: [id])
  stockLedgers   StockLedger[]
  saleItems      SaleItem[]
  careSchedules  CareSchedule[]
  createdAt      DateTime          @default(now())
}

model VermicompostBed {
  id            String    @id @default(uuid())
  bedCode       String    @unique // V-BED-01
  rawBiomassKg  Decimal   @db.Decimal(10, 2)
  cowDungKg     Decimal   @db.Decimal(10, 2)
  speciesWorms  String    @default("Eisenia foetida")
  startDate     DateTime
  expectedDate  DateTime
  harvestedDate DateTime?
  actualYieldKg Decimal?  @db.Decimal(10, 2)
  qualityGrade  String? // Grade A (Fine Powder), Grade B
  status        String    @default("DECOMPOSING")
}

model StockLedger {
  id          String         @id @default(uuid())
  plantId     String
  plant       PlantInventory @relation(fields: [plantId], references: [id])
  deltaQty    Int // Positive (+50) or Negative (-5)
  closingQty  Int
  actionType  String // SALE, PURCHASE, PROPAGATION_READY, MORTALITY, ADJUSTMENT
  referenceNo String? // Invoice number or Batch code
  recordedBy  String
  timestamp   DateTime       @default(now())
}

model Sale {
  id             String       @id @default(uuid())
  invoiceNumber  String       @unique // INV-2026-0001
  channel        SalesChannel @default(RETAIL_COUNTER)
  customerName   String
  customerPhone  String?
  customerCity   String?
  subTotal       Decimal      @db.Decimal(12, 2)
  discountAmount Decimal      @default(0.0) @db.Decimal(10, 2)
  netTotal       Decimal      @db.Decimal(12, 2)
  paymentMode    PaymentMode  @default(CASH)
  items          SaleItem[]
  createdAt      DateTime     @default(now())
}

model SaleItem {
  id             String         @id @default(uuid())
  saleId         String
  sale           Sale           @relation(fields: [saleId], references: [id])
  plantId        String
  plant          PlantInventory @relation(fields: [plantId], references: [id])
  quantity       Int
  unitPrice      Decimal        @db.Decimal(10, 2)
  itemTotalPrice Decimal        @db.Decimal(10, 2)
}

model CareSchedule {
  id          String         @id @default(uuid())
  plantId     String
  plant       PlantInventory @relation(fields: [plantId], references: [id])
  taskType    String // WATERING, NPK_SPRAY, FUNGICIDE, PRUNING
  frequency   String // DAILY, WEEKLY, BI_WEEKLY
  scheduledOn DateTime
  completedOn DateTime?
  status      String         @default("PENDING")
  staffNotes  String?
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String
  payload   String?
  timestamp DateTime @default(now())
}
